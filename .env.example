# =============================================================================
# SENTIMENT ALGO TRADER - CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# GROWW API (Required for live trading)
# Get your API key from: https://groww.in/trade-api/api-keys
# -----------------------------------------------------------------------------
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# -----------------------------------------------------------------------------
# SENTIMENT DATA SOURCES
# -----------------------------------------------------------------------------

# Alpha Vantage (Free tier: 25 requests/day)
# Get your key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub (Free tier: 60 calls/minute)
# Get your key from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# NewsAPI (Free tier: 100 requests/day)
# Get your key from: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# EODHD (Optional - paid service with sentiment)
# Get your key from: https://eodhd.com/
EODHD_API_KEY=your_eodhd_key_here

# -----------------------------------------------------------------------------
# TRADING CONFIGURATION
# -----------------------------------------------------------------------------

# Trading mode: "paper" (simulated) or "live" (real money)
TRADING_MODE=paper

# Default capital allocation (INR)
INITIAL_CAPITAL=100000

# Risk management
MAX_POSITION_SIZE_PERCENT=10
MAX_PORTFOLIO_RISK_PERCENT=2
STOP_LOSS_PERCENT=3
TAKE_PROFIT_PERCENT=6
MAX_DAILY_LOSS_PERCENT=5

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/trading.db

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your_notification_email@gmail.com

# -----------------------------------------------------------------------------
# DASHBOARD
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
SECRET_KEY=your_secret_key_for_jwt_here

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
